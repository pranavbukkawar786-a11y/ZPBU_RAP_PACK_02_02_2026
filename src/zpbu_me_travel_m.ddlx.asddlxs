@Metadata.layer: #CORE
@Search.searchable: true //this will create a global search option for all fields with selectionoption on
@UI.headerInfo :
{
    typeName: 'Travel',
    typeNamePlural: 'Travels',  //this will give number of records
    title: {
        type : #STANDARD,
        label: 'Travel Details',
        value: 'TravelId' //this will travel record to next page like "HIDE" keyword
    },
    description : {
        value: 'Name'
    }
}
annotate view zpbu_c_travel_m with
{
  //  @UI.facet: [{
  //      purpose : #HEADER,
  //      type : #DATAPOINT_REFERENCE,
  //      position : 10,
  //      targetQualifier : 'display_status'
  //    },
  //    {
  //      purpose : #HEADER,
  //      type : #DATAPOINT_REFERENCE,
  //      position : 20,
  //      targetQualifier : 'Overall_status'
  //    }]
  @UI.facet: [{
                  purpose : #HEADER,
                  type : #DATAPOINT_REFERENCE,
                  position : 10,
                  targetQualifier: 'display_status'
               },
               {
                  purpose : #HEADER,
                  type : #DATAPOINT_REFERENCE,
                  position : 20,
                  targetQualifier: 'Overall_status'
               },
               {
                   purpose: #STANDARD,
                   type : #COLLECTION,
                   label : 'Collection Facet',
                   id    : 'Collection',
                   position:  10
               },
               {
                   purpose : #STANDARD,
                   type : #IDENTIFICATION_REFERENCE,
                   parentId: 'Collection',
                   label : 'Id - ID other Details',
                   position:  10
               },
               {
                   purpose: #STANDARD,
                   type : #FIELDGROUP_REFERENCE,
                   parentId: 'Collection',
                   label : 'Field Group 1',
                   position:  20,
                   targetQualifier: 'FG1'
               },
               {
                   purpose: #STANDARD,
                   type : #FIELDGROUP_REFERENCE,
                   parentId: 'Collection',
                   label : 'Field Group 2',
                   position:  30,
                   targetQualifier: 'FG2'
               },
               {
                    purpose: #STANDARD,
                    type : #LINEITEM_REFERENCE,
                    label : 'Corresponding Booking Details',
                    position:  20,
                    targetElement: '_booking'

                }]

  @UI.lineItem: [{ position: 10 }]
  @UI.selectionField: [{ position: 10 }]
  @Search.defaultSearchElement: true // this will be global search option only
  @UI.identification: [{ position: 10 }]
  TravelId;

  @UI.lineItem: [{ position: 20 }]
  @Search.defaultSearchElement: true // this will be global search option only
  @UI.identification: [{ position: 20 }]
  AgencyId;

  @UI.lineItem: [{ position: 25 }]
  @UI.selectionField: [{ position: 25 }]
  @Consumption.valueHelpDefinition: [{
                                      entity.name: '/DMO/I_AGENCY',
                                      entity.element:'Name' }]
  @UI.identification: [{ position: 30 }]
  Name;

  @UI.lineItem: [{ position: 30 }]
  @Search.defaultSearchElement: true // this will be global search option only
  @UI.identification: [{ position: 40 }]
  CustomerId;

  @UI.lineItem: [{ position: 35 }]
  @UI.selectionField: [{ position: 35 }]
  @Consumption.valueHelpDefinition:
  [{
     entity.name: '/DMO/I_Customer',
     entity.element: 'FirstName'
  }]
  @UI.identification: [{ position: 50 }]
  FirstName;

  @UI.lineItem: [{ position: 40 }]
  @UI.fieldGroup: [{ position: 10, qualifier: 'FG1' }]
  BeginDate;

  @UI.lineItem: [{ position: 50 }]
  @UI.fieldGroup: [{ position: 20, qualifier: 'FG1' }]
  EndDate;

  //    BookingFee;
  @UI.lineItem: [{ position: 60 }]
  @UI.dataPoint : { qualifier: 'display_status', title: 'Total Booking Price' }
  @UI.fieldGroup: [{ position: 10, qualifier: 'FG2' }]

  TotalPrice;
  //    CurrencyCode;
  //    Description;
  @UI.lineItem: [{ position: 70 }]
  @UI.selectionField: [{ position: 70 }]
  @Search.defaultSearchElement: true
  @Consumption.valueHelpDefinition:
  [{
       entity.name: '/DMO/I_Overall_Status_VH',
       entity.element: 'OverallStatus'
  }]
  @UI.dataPoint : { qualifier: 'Overall_status', title: 'Booking Status' }
  @UI.fieldGroup: [{ position: 20, qualifier: 'FG2' }]
  OverallStatus;
  @UI.fieldGroup: [{ position: 30, qualifier: 'FG1' }]
  CreatedBy;
  @UI.fieldGroup: [{ position: 40, qualifier: 'FG1' }]
  CreatedAt;

  //  OverallStatus;
  //    CreatedBy;
  //    CreatedAt;
  //    LastChangedBy;
  //    LastChangedAt;

}