projection;
strict ( 2 );
use side effects;

define behavior for zpbu_c_travel_m alias Travel
use etag
{
  use create;
  use update;
  use delete;

  use association _booking { create; }
}

define behavior for zpbu_c_booking_m alias Booking
use etag
{
  use update;
  use delete;

  use association _travel;
  use association _booksuppl { create; }
}

define behavior for zpbu_c_booksuppl_m alias BookSuppl
use etag
{
  use update;
  use delete;

  use association _travel;
  use association _booking;
}